[Unit]
Description=PortTunnel Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ptunnel
Group=ptunnel
WorkingDirectory=/opt/ptunnel-client
ExecStart=/opt/ptunnel-client/ptunnel-client -c /opt/ptunnel-client/client.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ptunnel-client

[Install]
WantedBy=multi-user.target